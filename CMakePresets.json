{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"toolchainFile": "${sourceDir}/cmake/clang-cl-toolchain.cmake",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"displayName": "Windows base"
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"description": "Windows Debug with clang-cl and Ninja.",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"displayName": "Release",
			"description": "Windows Release with clang-cl and Ninja.",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "linux-base",
			"hidden": true,
			"displayName": "Linux base",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-22",
				"CMAKE_CXX_COMPILER": "clang++-22",
				"CMAKE_CXX_FLAGS": "-stdlib=libc++",
				"CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-debug",
			"displayName": "Linux Debug",
			"description": "Linux Debug with Clang 22, libc++ and Ninja.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release",
			"description": "Linux Release with Clang 22, libc++ and Ninja.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "linux-tsan",
			"displayName": "Linux TSan",
			"description": "Linux Debug with Clang 22, libc++ and ThreadSanitizer-instrumented concurrency tests.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"GLIRPS_ENABLE_TSAN": "ON"
			}
		},
		{
			"name": "package",
			"displayName": "Package",
			"description": "Windows package of the library alone: headers, library, and CMake package.",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
				"GLIRPS_BUILD_TESTS": "OFF",
				"GLIRPS_BUILD_EXAMPLES": "OFF",
				"GLIRPS_ENABLE_TSAN": "OFF",
				"GLIRPS_INSTALL": "ON"
			}
		},
		{
			"name": "linux-package",
			"displayName": "Linux Package",
			"description": "Linux package of the library alone: headers, library, and CMake package.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
				"GLIRPS_BUILD_TESTS": "OFF",
				"GLIRPS_BUILD_EXAMPLES": "OFF",
				"GLIRPS_ENABLE_TSAN": "OFF",
				"GLIRPS_INSTALL": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "linux-debug",
			"configurePreset": "linux-debug"
		},
		{
			"name": "linux-release",
			"configurePreset": "linux-release"
		},
		{
			"name": "linux-tsan",
			"configurePreset": "linux-tsan"
		},
		{
			"name": "package",
			"configurePreset": "package",
			"targets": ["install"]
		},
		{
			"name": "linux-package",
			"configurePreset": "linux-package",
			"targets": ["install"]
		}
	],
	"testPresets": [
		{
			"name": "debug",
			"configurePreset": "debug",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "release",
			"configurePreset": "release",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux-debug",
			"configurePreset": "linux-debug",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux-release",
			"configurePreset": "linux-release",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux-tsan",
			"configurePreset": "linux-tsan",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
